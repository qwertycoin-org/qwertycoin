#define DEF_QWERTYCOIN_VERSION "2.0.5"
#define DEF_QWERTYCOIN_RELEASE_NAME "QWC v2 Mainnet"
#define DEF_QWERTYCOIN_VERSION_TAG "@VERSIONTAG@"
#define DEF_QWERTYCOIN_VERSION_FULL DEF_QWERTYCOIN_VERSION "-" DEF_QWERTYCOIN_VERSION_TAG
#define DEF_QWERTYCOIN_VERSION_IS_RELEASE @VERSION_IS_RELEASE@
// Preserve the four-component format used by hardware and legacy RPC clients.
#define DEF_QWERTYCOIN_COMPATIBLE_VERSION DEF_QWERTYCOIN_VERSION ".0"
#define DEF_QWERTYCOIN_COMPATIBLE_VERSION_FULL DEF_QWERTYCOIN_COMPATIBLE_VERSION "-" DEF_QWERTYCOIN_VERSION_TAG

#include "version.h"

const char* const QWERTYCOIN_VERSION = DEF_QWERTYCOIN_VERSION;
const char* const QWERTYCOIN_RELEASE_NAME = DEF_QWERTYCOIN_RELEASE_NAME;
const char* const QWERTYCOIN_VERSION_TAG = DEF_QWERTYCOIN_VERSION_TAG;
const char* const QWERTYCOIN_VERSION_FULL = DEF_QWERTYCOIN_VERSION_FULL;
const bool QWERTYCOIN_VERSION_IS_RELEASE = DEF_QWERTYCOIN_VERSION_IS_RELEASE;
const char* const QWERTYCOIN_COMPATIBLE_VERSION = DEF_QWERTYCOIN_COMPATIBLE_VERSION;
const char* const QWERTYCOIN_COMPATIBLE_VERSION_FULL = DEF_QWERTYCOIN_COMPATIBLE_VERSION_FULL;
